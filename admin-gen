#!/usr/bin/env python3
"""admin-gen — manifest-driven admin script generator.

Usage:
    admin-gen [PROJECT_DIR]                    # bootstrap: detect + write admin.toml + generate
    admin-gen --regenerate [PROJECT_DIR]       # reload admin.toml, regenerate ./admin
    admin-gen --audit [PROJECT_DIR]            # regenerate in memory, diff against ./admin

    When PROJECT_DIR has an admin.toml already, the default action (no flags) is regenerate.
    When PROJECT_DIR has no admin.toml, the default action is bootstrap.

Flags:
    --bootstrap       force bootstrap mode (detect + write admin.toml + generate)
    --force-dirty     allow generating from a dirty admin-project-tool working tree
    --force           overwrite existing admin.toml on bootstrap
"""
from __future__ import annotations

import argparse
import difflib
import os
import stat
import sys
from pathlib import Path

# Script layout:
#   <repo>/admin-gen
#   <repo>/gen/            (importable as `gen`)
#   <repo>/admin_lib/
#   <repo>/archetypes/
#   <repo>/detectors/
REPO_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO_DIR))

from gen.manifest import (  # noqa: E402
    Manifest,
    ManifestError,
    dump as dump_manifest,
    load as load_manifest,
    require_python_311,
)
from gen.archetypes import resolve, ResolvedManifest  # noqa: E402
from gen.render import render, generator_commit_sha, RenderError  # noqa: E402
from gen.detectors import detect as run_detectors  # noqa: E402


ARCHETYPE_DIR = REPO_DIR / "archetypes"
DETECTOR_DIR = REPO_DIR / "detectors"
ADMIN_LIB_DIR = REPO_DIR / "admin_lib"


# ---------------------------------------------------------------------------
# Simple output helpers (stand-alone — we can't import admin_lib.core here
# since the generator runs on the host, not inside a bundled admin script)
# ---------------------------------------------------------------------------

def info(msg):
    print(f"\033[34m{msg}\033[0m")


def ok(msg):
    print(f"\033[32m{msg}\033[0m")


def warn(msg):
    print(f"\033[33m{msg}\033[0m", file=sys.stderr)


def err(msg):
    print(f"\033[31merror: {msg}\033[0m", file=sys.stderr)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_bootstrap(project_dir: Path, args) -> int:
    """First-time setup: detect stack → write admin.toml → generate ./admin."""
    manifest_path = project_dir / "admin.toml"
    admin_path = project_dir / "admin"

    if manifest_path.exists() and not args.force:
        warn(f"{manifest_path} already exists — run with --regenerate or --force")
        return 1

    info(f"detecting project stack in {project_dir}")
    starter = run_detectors(project_dir, DETECTOR_DIR)
    detector_name = starter.pop("_detector", "unknown")
    info(f"detector matched: {detector_name}")

    project_name = starter.get("project_name") or project_dir.resolve().name.replace("-", " ").title()
    manifest = Manifest(
        project_name=project_name,
        python_min="3.11",
        archetypes=starter.get("archetypes", ["simple"]),
        modules=starter.get("modules", []),
        urls=starter.get("urls", {}),
        overrides={},
        custom={},
        order=[],
    )

    try:
        sha = generator_commit_sha(REPO_DIR, allow_dirty=args.force_dirty)
    except RenderError as e:
        err(str(e))
        return 1
    manifest.generator_commit = sha

    manifest_path.write_text(dump_manifest(manifest))
    ok(f"wrote {manifest_path}")

    rc = _regenerate(project_dir, args)
    if rc != 0:
        return rc

    _ensure_tmp_gitignore(project_dir)
    info(f"bootstrap complete. Edit {manifest_path} and run 'admin regenerate' to update ./admin.")
    return 0


def cmd_regenerate(project_dir: Path, args) -> int:
    """Reload admin.toml and regenerate ./admin."""
    return _regenerate(project_dir, args)


def _regenerate(project_dir: Path, args) -> int:
    try:
        manifest = load_manifest(project_dir)
    except ManifestError as e:
        err(str(e))
        return 1

    try:
        sha = generator_commit_sha(REPO_DIR, allow_dirty=args.force_dirty)
    except RenderError as e:
        err(str(e))
        return 1

    if manifest.generator_commit != sha:
        info(f"updating generator_commit: {manifest.generator_commit} → {sha}")
        manifest.generator_commit = sha
        toml_path = project_dir / "admin.toml"
        import re as _re
        text = toml_path.read_text()
        text = _re.sub(
            r'generator_commit\s*=\s*"[^"]*"',
            f'generator_commit = "{sha}"',
            text,
            count=1,
        )
        toml_path.write_text(text)

    try:
        resolved = resolve(manifest, ARCHETYPE_DIR)
    except Exception as e:
        err(f"archetype resolution failed: {e}")
        return 1

    for event in resolved.merge_log:
        info(f"merge: {event}")

    inline_body = None
    if manifest.inline_file:
        inline_path = project_dir / manifest.inline_file
        if not inline_path.exists():
            err(f"inline file not found: {inline_path}")
            return 1
        inline_body = inline_path.read_text()
        info(f"inline: {manifest.inline_file} ({len(inline_body.splitlines())} lines)")

    try:
        script = render(resolved, ADMIN_LIB_DIR, generator_commit=sha, inline_body=inline_body)
    except Exception as e:
        err(f"render failed: {e}")
        return 1

    for issue in _audit_inline_code(manifest):
        warn(issue)

    admin_path = project_dir / "admin"
    admin_path.write_text(script)
    _make_executable(admin_path)
    _ensure_tmp_gitignore(project_dir)
    _ensure_gitattributes(project_dir)
    ok(f"wrote {admin_path} ({len(script.splitlines())} lines)")
    return 0


def cmd_audit(project_dir: Path, args) -> int:
    """Regenerate in memory and diff against the on-disk ./admin."""
    try:
        manifest = load_manifest(project_dir)
    except ManifestError as e:
        err(str(e))
        return 1

    try:
        sha = generator_commit_sha(REPO_DIR, allow_dirty=True)
    except RenderError as e:
        err(str(e))
        return 1

    inline_body = None
    if manifest.inline_file:
        inline_path = project_dir / manifest.inline_file
        if inline_path.exists():
            inline_body = inline_path.read_text()

    try:
        resolved = resolve(manifest, ARCHETYPE_DIR)
    except Exception as e:
        err(f"audit validation failed: {e}")
        return 1
    try:
        script = render(resolved, ADMIN_LIB_DIR, generator_commit=sha, inline_body=inline_body)
    except Exception as e:
        err(f"audit render failed: {e}")
        return 1

    admin_path = project_dir / "admin"
    if not admin_path.exists():
        warn(f"{admin_path} does not exist — run: admin regenerate")
        return 1

    on_disk = admin_path.read_text()

    # Check for specific missing modules that have been added to archetypes since
    # the on-disk admin was generated. These produce a targeted warning in addition
    # to the general diff so the reason for regeneration is clear.
    disk_modules = _parse_bundled_modules(on_disk)
    needed_modules = set(resolved.modules)
    for module in sorted(needed_modules - disk_modules):
        warn(
            f"module '{module}' missing from bundled admin — "
            f"regenerate to pick up new features (run: admin regenerate)"
        )

    # Check for inline code that should be migrated to admin_lib / archetypes.
    for issue in _audit_inline_code(manifest):
        warn(issue)

    # Suggest kill-port if project binds TCP ports but has no kill command.
    for suggestion in _audit_suggest_kill_port(resolved):
        info(suggestion)

    if on_disk == script:
        ok("clean: ./admin matches admin.toml + current archetypes")
        if manifest.generator_commit and manifest.generator_commit != sha:
            info(
                f"note: manifest generator_commit={manifest.generator_commit} "
                f"but admin-project-tool HEAD={sha} — run: admin regenerate"
            )
        return 0

    warn("drift detected between admin.toml and ./admin")
    diff = difflib.unified_diff(
        on_disk.splitlines(keepends=True),
        script.splitlines(keepends=True),
        fromfile="admin (on disk)",
        tofile="admin (would regenerate)",
        n=3,
    )
    sys.stdout.writelines(diff)
    return 2


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_INLINE_SIMPLE_THRESHOLD = 4   # ≤ this many logic lines → acceptable
_INLINE_COMPLEX_THRESHOLD = 8  # > this many logic lines → migration required


def _count_logic_lines(run: str) -> tuple[int, list[str]]:
    """Return (logic_line_count, signals) for an inline Python run string.

    logic_line_count excludes blank lines. signals is a list of short strings
    describing complexity indicators (loops, imports, direct low-level calls).
    """
    lines = [l.rstrip() for l in run.splitlines() if l.strip()]
    signals = []
    if any(l.lstrip().startswith(("for ", "while ")) for l in lines):
        signals.append("contains loops")
    if any(l.lstrip().startswith("import ") or " import " in l for l in lines):
        signals.append("contains imports (logic that belongs in admin_lib)")
    direct_calls = {"run_cmd(", "info(", "ok(", "err(", "warn("}
    if sum(1 for l in lines if any(c in l for c in direct_calls)) > 3:
        signals.append("many direct low-level calls (wrap in an admin_lib function)")
    return len(lines), signals


def _audit_inline_code(manifest: "Manifest") -> list[str]:
    """Return warning strings for inline code commands that should be migrated.

    Checks all manifest [commands] overrides and custom commands for
    kind='python' entries with multi-line run strings. Returns a sorted list
    of human-readable warnings. Empty list means no issues found.

    Rules:
      ≤ 4 logic lines                    → OK (single function call + dispatch)
      4 < lines ≤ 8, or complexity signals → warn (consider wrapping)
      > 8 logic lines                    → migration required
    """
    issues: list[str] = []

    all_commands: dict = {}
    all_commands.update(manifest.overrides)
    all_commands.update(manifest.custom)

    for name, cmd in all_commands.items():
        if not isinstance(cmd, dict):
            continue
        if cmd.get("kind") != "python":
            continue
        run = cmd.get("run", "")
        if not isinstance(run, str):
            continue

        count, signals = _count_logic_lines(run)

        if count > _INLINE_COMPLEX_THRESHOLD:
            issues.append(
                f"commands.{name}: {count}-line inline code — "
                f"migrate logic to admin_lib or a new archetype "
                f"(run: /admin for a migration plan)"
                + (f" [{'; '.join(signals)}]" if signals else "")
            )
        elif count > _INLINE_SIMPLE_THRESHOLD or signals:
            issues.append(
                f"commands.{name}: moderately complex inline code ({count} lines)"
                + (f" [{'; '.join(signals)}]" if signals else "")
                + " — consider wrapping in an admin_lib function"
            )

    if manifest.inline_file:
        issues.append(
            f"[inline] file = \"{manifest.inline_file}\" detected — "
            f"inline code files are a migration target, not a pattern. "
            f"Move logic into admin_lib modules or archetypes in admin-project-tool."
        )

    return issues


def _audit_suggest_kill_port(resolved: ResolvedManifest) -> list[str]:
    """Return a suggestion when the 'ports' module is bundled but no kill-port command exists."""
    if "ports" not in resolved.modules:
        return []
    all_cmds = {**resolved.commands, **resolved.actions}
    if any(c.kind in ("kill-port", "nuke-dev") for c in all_cmds.values()):
        return []
    return [
        "suggestion: project bundles the 'ports' module but has no kill-port command; "
        "consider adding one (kind = \"kill-port\") to let devs free ports without restarting"
    ]


def _parse_bundled_modules(admin_src: str) -> set[str]:
    """Extract the modules list from the @bundled header line in an admin script.

    Returns an empty set if the header is absent or malformed (e.g. old-format scripts).
    """
    import re
    for line in admin_src.splitlines()[:5]:
        m = re.search(r"modules=([\w,]+)", line)
        if m:
            return set(m.group(1).split(","))
    return set()


def _make_executable(path: Path) -> None:
    st = path.stat()
    path.chmod(st.st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def _ensure_tmp_gitignore(project_dir: Path) -> None:
    tmp = project_dir / "tmp"
    tmp.mkdir(exist_ok=True)
    gi = tmp / ".gitignore"
    if not gi.exists():
        gi.write_text("*\n!.gitignore\n")


def _ensure_gitattributes(project_dir: Path) -> None:
    """Add `./admin linguist-generated=true` to .gitattributes if absent.

    This hides the 2000-line generated bundle from GitHub PR diffs by default
    without affecting local git behavior or removing the file from the repo.
    """
    ga = project_dir / ".gitattributes"
    marker = "linguist-generated=true"
    entry = f"admin {marker}\n"
    if ga.exists():
        existing = ga.read_text()
        if entry.rstrip("\n") in existing:
            return
        ga.write_text(existing.rstrip("\n") + "\n" + entry)
    else:
        ga.write_text(entry)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> int:
    require_python_311()

    parser = argparse.ArgumentParser(prog="admin-gen", description=__doc__)
    parser.add_argument("project_dir", nargs="?", default=".", help="project directory")
    parser.add_argument("--regenerate", action="store_true", help="reload admin.toml and regenerate ./admin")
    parser.add_argument("--bootstrap", action="store_true", help="force bootstrap mode (detect + write admin.toml + generate)")
    parser.add_argument("--audit", action="store_true", help="diff ./admin against what would be regenerated")
    parser.add_argument("--force", action="store_true", help="overwrite existing admin.toml on bootstrap")
    parser.add_argument("--force-dirty", action="store_true", help="allow generation from dirty admin-project-tool tree")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).resolve()
    if not project_dir.is_dir():
        err(f"not a directory: {project_dir}")
        return 1

    if args.audit:
        return cmd_audit(project_dir, args)
    if args.regenerate and args.bootstrap:
        err("--regenerate and --bootstrap are mutually exclusive")
        return 1
    if args.regenerate:
        return cmd_regenerate(project_dir, args)
    if args.bootstrap:
        return cmd_bootstrap(project_dir, args)

    # Context-smart auto-detect: if admin.toml exists, regenerate; otherwise bootstrap.
    manifest_path = project_dir / "admin.toml"
    if manifest_path.exists():
        return cmd_regenerate(project_dir, args)
    return cmd_bootstrap(project_dir, args)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""init-admin — Bootstrap new admin scripts from templates, or audit existing ones.

Standalone script (stdlib only). Does NOT import admin_lib — it reads template
files and does string substitution to avoid the bootstrap chicken-and-egg problem.
"""

import argparse
import os
import re
import stat
import sys


# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------

class C:
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    CYAN = "\033[36m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RESET = "\033[0m"


def info(msg):
    print(f"{C.CYAN}{msg}{C.RESET}")


def ok(msg):
    print(f"{C.GREEN}{msg}{C.RESET}")


def warn(msg):
    print(f"{C.YELLOW}{msg}{C.RESET}", file=sys.stderr)


def err(msg):
    print(f"{C.RED}{msg}{C.RESET}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Project type detection
# ---------------------------------------------------------------------------

def detect_project_type(project_dir):
    """Detect project type from filesystem markers.

    Returns "apple", "docker", or "basic".
    """
    entries = set(os.listdir(project_dir))

    for entry in entries:
        if entry.endswith(".xcodeproj") or entry.endswith(".xcworkspace"):
            return "apple"

    docker_markers = {
        "Dockerfile", "docker-compose.yml", "docker-compose.yaml",
        "compose.yml", "compose.yaml",
    }
    if entries & docker_markers:
        return "docker"

    return "basic"


def has_web_component(project_dir):
    """Detect if the project serves a web UI or HTTP API."""
    entries = set(os.listdir(project_dir))

    web_dirs = {"public", "static", "views"}
    if entries & web_dirs:
        return True

    if "templates" in entries:
        tmpl_dir = os.path.join(project_dir, "templates")
        if os.path.isdir(tmpl_dir):
            for f in os.listdir(tmpl_dir):
                if f.endswith((".html", ".jinja", ".jinja2")):
                    return True

    web_files = {"index.html", "server.js", "app.js", "server.ts", "app.ts"}
    if entries & web_files:
        return True

    web_keywords = ("express", "flask", "fastapi", "http.createServer", "app.listen")
    for name in ("server.js", "app.js", "server.py", "app.py", "main.py"):
        path = os.path.join(project_dir, name)
        if os.path.isfile(path):
            try:
                with open(path) as f:
                    head = f.read(2048)
                if any(kw in head for kw in web_keywords):
                    return True
            except OSError:
                pass

    return False


# ---------------------------------------------------------------------------
# Variable inference
# ---------------------------------------------------------------------------

def infer_project_name(project_dir):
    """Derive a human-readable project name from the directory basename."""
    basename = os.path.basename(os.path.abspath(project_dir))
    return basename.replace("-", " ").replace("_", " ").title()


def infer_basic_vars(project_dir):
    """Infer BUILD_CMD and TEST_CMD for basic template."""
    entries = set(os.listdir(project_dir))
    variables = {}

    if "go.mod" in entries:
        variables["BUILD_CMD"] = "go build ./cmd/..."
        variables["TEST_CMD"] = "go test ./..."
    elif "Cargo.toml" in entries:
        variables["BUILD_CMD"] = "cargo build"
        variables["TEST_CMD"] = "cargo test"
    elif "Makefile" in entries:
        variables["BUILD_CMD"] = "make"
        variables["TEST_CMD"] = "make test"
    elif "package.json" in entries:
        variables["BUILD_CMD"] = "npm run build"
        variables["TEST_CMD"] = "npm test"
    else:
        variables["BUILD_CMD"] = 'echo "TODO: add build command"'
        variables["TEST_CMD"] = 'echo "TODO: add test command"'

    return variables


def infer_apple_vars(project_dir):
    """Infer XCODEPROJ, SCHEME, PROCESS, SUBSYSTEM, PLATFORM for apple template."""
    variables = {}

    xcodeproj = None
    for entry in os.listdir(project_dir):
        if entry.endswith(".xcodeproj"):
            xcodeproj = entry
            break

    scheme = xcodeproj[:-len(".xcodeproj")] if xcodeproj else None
    if not scheme:
        scheme = os.path.basename(os.path.abspath(project_dir))
        xcodeproj = f"{scheme}.xcodeproj"

    variables["XCODEPROJ"] = xcodeproj
    variables["SCHEME"] = scheme
    variables["PROCESS"] = scheme

    subsystem = None
    platform = "macos"
    pbxproj = os.path.join(project_dir, xcodeproj, "project.pbxproj")
    if os.path.isfile(pbxproj):
        try:
            with open(pbxproj) as f:
                content = f.read()
            m = re.search(r'PRODUCT_BUNDLE_IDENTIFIER\s*=\s*"?([^";]+)', content)
            if m:
                subsystem = m.group(1)
            if re.search(r'SDKROOT\s*=\s*iphoneos', content):
                platform = "ios"
            elif re.search(r'IPHONEOS_DEPLOYMENT_TARGET', content):
                platform = "ios"
        except OSError:
            pass

    if not subsystem:
        subsystem = f"com.example.{scheme}"
    variables["SUBSYSTEM"] = subsystem
    variables["PLATFORM"] = platform

    return variables


def infer_docker_vars(project_dir):
    """Infer DOCKER_IMAGE for server template."""
    basename = os.path.basename(os.path.abspath(project_dir))
    return {"DOCKER_IMAGE": basename.lower().replace(" ", "-").replace("_", "-")}


def infer_sync_vars(project_dir, subdir=None):
    """Infer variables for a sync-type target."""
    variables = {}
    base = os.path.join(project_dir, subdir) if subdir else project_dir
    pkg_json = os.path.join(base, "package.json")
    if os.path.isfile(pkg_json):
        try:
            import json
            with open(pkg_json) as f:
                pkg = json.load(f)
            scripts = pkg.get("scripts", {})
            if "build" in scripts:
                prefix = f"cd {subdir} && " if subdir else ""
                variables["BUILD_CMD"] = f"{prefix}npm run build"
        except (OSError, ValueError):
            pass
    if "BUILD_CMD" not in variables:
        variables["BUILD_CMD"] = 'echo "TODO: add build command"'
    variables["DIST_DIR"] = "dist"
    variables["DEPLOY_DEST_ENV"] = "DEPLOY_TARGET"
    variables["DEPLOY_SUBDIR"] = os.path.basename(os.path.abspath(project_dir))
    variables["EXCLUDES"] = '["__pycache__", "*.pyc"]'
    return variables


# ---------------------------------------------------------------------------
# Multi-target detection
# ---------------------------------------------------------------------------

TARGET_TYPE_COMMANDS = {
    "apple":  {"build", "dev", "deploy"},
    "docker": {"build", "dev", "deploy"},
    "sync":   {"build", "deploy"},
    "basic":  {"build", "dev", "deploy"},
}

DOCKER_MARKERS = {
    "Dockerfile", "docker-compose.yml", "docker-compose.yaml",
    "compose.yml", "compose.yaml",
}


def detect_all_targets(project_dir):
    """Scan for all project patterns. Returns list of target dicts.

    Each dict: {"name": str, "type": str, "label": str, "vars": dict}
    """
    targets = []
    entries = set(os.listdir(project_dir))

    for entry in sorted(entries):
        if entry.endswith(".xcodeproj"):
            apple_vars = infer_apple_vars(project_dir)
            platform = apple_vars.get("PLATFORM", "macos")
            targets.append({
                "name": platform,
                "type": "apple",
                "label": f"{platform.title()} {apple_vars.get('SCHEME', '')}",
                "vars": apple_vars,
            })

    if entries & DOCKER_MARKERS:
        docker_vars = infer_docker_vars(project_dir)
        targets.append({
            "name": "server",
            "type": "docker",
            "label": f"Docker ({docker_vars['DOCKER_IMAGE']})",
            "vars": docker_vars,
        })

    for entry in sorted(entries):
        subdir = os.path.join(project_dir, entry)
        if not os.path.isdir(subdir) or entry.startswith("."):
            continue
        sub_entries = set(os.listdir(subdir))

        if sub_entries & DOCKER_MARKERS:
            docker_vars = infer_docker_vars(subdir)
            docker_vars["CONTEXT_DIR"] = entry
            targets.append({
                "name": entry,
                "type": "docker",
                "label": f"Docker ({entry})",
                "vars": docker_vars,
            })

        for sub_entry in sub_entries:
            if sub_entry.endswith(".xcodeproj"):
                apple_vars = infer_apple_vars(subdir)
                platform = apple_vars.get("PLATFORM", "macos")
                apple_vars["XCODEPROJ"] = os.path.join(entry, apple_vars["XCODEPROJ"])
                name = platform if not any(t["name"] == platform for t in targets) else entry
                targets.append({
                    "name": name,
                    "type": "apple",
                    "label": f"{platform.title()} {apple_vars.get('SCHEME', '')}",
                    "vars": apple_vars,
                })

        pkg_json = os.path.join(subdir, "package.json")
        if os.path.isfile(pkg_json):
            try:
                import json
                with open(pkg_json) as f:
                    pkg = json.load(f)
                if "build" in pkg.get("scripts", {}):
                    sync_vars = infer_sync_vars(project_dir, entry)
                    targets.append({
                        "name": entry,
                        "type": "sync",
                        "label": f"JS build ({entry})",
                        "vars": sync_vars,
                    })
            except (OSError, ValueError):
                pass

    if "go.mod" in entries or "Cargo.toml" in entries:
        if not any(t["type"] in ("docker",) and t["name"] == "server" for t in targets):
            basic_vars = infer_basic_vars(project_dir)
            targets.append({
                "name": "main",
                "type": "basic",
                "label": infer_project_name(project_dir),
                "vars": basic_vars,
            })

    if not targets:
        basic_vars = infer_basic_vars(project_dir)
        targets.append({
            "name": "main",
            "type": "basic",
            "label": infer_project_name(project_dir),
            "vars": basic_vars,
        })

    seen = set()
    for t in targets:
        while t["name"] in seen:
            t["name"] = t["name"] + "2"
        seen.add(t["name"])

    return targets


def confirm_targets(targets):
    """Interactive confirmation of detected targets. Returns filtered list."""
    print()
    info("Detected targets:")
    for i, t in enumerate(targets, 1):
        type_label = t["type"]
        if t["type"] == "apple":
            type_label = f"apple/{t['vars'].get('PLATFORM', 'macos')}"
        print(f"  {i}. [{type_label}] {C.BOLD}{t['name']:<12}{C.RESET} {t['label']}")
    print()

    if not sys.stdout.isatty():
        return targets

    try:
        answer = input(f"  Keep all? [{C.BOLD}Y{C.RESET}/n/edit] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return None

    if answer in ("", "y", "yes"):
        return targets

    if answer in ("n", "no"):
        return None

    if answer == "edit":
        print()
        print(f"  Enter target numbers to keep (comma-separated), or new names:")
        print(f"  Example: 1,2 or 1=web,2=ios")
        try:
            edit_input = input("  > ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return None

        kept = []
        for part in edit_input.split(","):
            part = part.strip()
            try:
                if "=" in part:
                    idx_str, new_name = part.split("=", 1)
                    idx = int(idx_str.strip()) - 1
                    if 0 <= idx < len(targets):
                        t = dict(targets[idx])
                        t["name"] = new_name.strip()
                        kept.append(t)
                else:
                    idx = int(part.strip()) - 1
                    if 0 <= idx < len(targets):
                        kept.append(targets[idx])
            except ValueError:
                warn(f"  Skipping invalid entry: {part}")
                continue
        return kept if kept else None

    return targets



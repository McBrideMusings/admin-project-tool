def audit(project_dir):
    """Audit an existing admin script."""
    admin_path = os.path.join(project_dir, "admin")
    if not os.path.isfile(admin_path):
        err(f"No admin script found at {admin_path}")
        return 1

    with open(admin_path) as f:
        content = f.read()
    lines = content.splitlines()
    line_count = len(lines)

    uses_admin_lib = "admin_lib" in content

    if uses_admin_lib:
        return _audit_admin_lib(project_dir, content, lines, line_count)
    else:
        return _audit_standalone(project_dir, content, lines, line_count)


def _audit_admin_lib(project_dir, content, lines, line_count):
    """Audit an admin_lib-based script."""
    project_type = detect_project_type(project_dir)

    print(f"Audit: ./admin (admin_lib-based, {line_count} lines)")
    print()

    # Check 1: Library importable
    try:
        sys.path.insert(0, os.path.expanduser("~/.admin"))
        import admin_lib
        ok(f"  admin_lib importable (v{admin_lib.__version__})")
    except ImportError:
        err("  admin_lib not importable — is it installed?")

    # Check 2: Layer usage
    layers_used = []
    layer_map = {
        "admin_lib.core": "core",
        "admin_lib.apple": "apple",
        "admin_lib.docker": "docker",
        "admin_lib.server": "docker",
        "admin_lib.unraid": "unraid",
    }
    for import_str, layer_name in layer_map.items():
        if import_str in content:
            layers_used.append(layer_name)
    info(f"  Layers: {', '.join(layers_used) if layers_used else 'none'}")

    # Check 3: Layer opportunities
    if project_type == "apple" and "apple" not in layers_used:
        warn("  Opportunity: .xcodeproj found but admin_lib.apple not imported")
    if project_type == "docker" and "docker" not in layers_used:
        warn("  Opportunity: Docker files found but admin_lib.docker not imported")

    # Check 4: Decorator correctness
    print()
    info("  Decorator usage:")
    core_names = {"build", "dev", "deploy"}
    core_pattern = re.compile(r'@core\("(\w+)"')
    cmd_pattern = re.compile(r'@command\("(\w+)"')

    core_decorated = set(core_pattern.findall(content))
    cmd_decorated = set(cmd_pattern.findall(content))

    for name in core_names & cmd_decorated:
        warn(f"    @command(\"{name}\") should be @core(\"{name}\")")
    for name in core_names & core_decorated:
        ok(f"    @core(\"{name}\") — correct")
    for name in cmd_decorated - core_names:
        ok(f"    @command(\"{name}\") — correct")

    # Check 5: Multi-target support
    is_multi = "dispatch_target" in content
    has_pick_target = "pick_target" in content and "dispatch_target" not in content
    if is_multi:
        target_dicts = re.findall(r'_(\w+)_TARGETS\s*=\s*OrderedDict', content)
        target_count = len(set(target_dicts))
        ok(f"  Multi-target: dispatch_target in use ({target_count} command group(s))")
    elif has_pick_target:
        warn("  Opportunity: uses pick_target but not dispatch_target — consider migrating")

    # Check 6: Missing features
    print()
    info("  Features:")
    web = has_web_component(project_dir)
    checks = [
        ("reload command", "reload" in content and ("register_reload_command" in content or "register_server_reload_command" in content or 'def cmd_reload' in content)),
        ("tmp/.gitignore", os.path.isfile(os.path.join(project_dir, "tmp", ".gitignore"))),
        ("boot() call", "boot(" in content),
    ]
    if web:
        has_open = "open" in cmd_decorated or "register_open_command" in content
        checks.append(("set_urls() + open command", "set_urls" in content and has_open))
    for label, present in checks:
        if present:
            ok(f"    {label} — present")
        else:
            warn(f"    {label} — missing")
    if web and "set_urls" not in content:
        warn("  Web component detected — add set_urls() and register_open_command() for URL status in TUI")

    print()
    return 0


def _audit_standalone(project_dir, content, lines, line_count):
    """Audit a standalone (non-admin_lib) script."""
    project_type = detect_project_type(project_dir)

    print(f"Audit: ./admin (standalone, not using admin_lib)")
    print(f"  Type:     {project_type} (detected)")
    print(f"  Lines:    {line_count}")
    print()

    # Suggest migration layers
    layer_suggestions = ["admin_lib.core"]
    core_savings = 150
    type_savings = 0

    if project_type == "apple":
        layer_suggestions.append("admin_lib.apple")
        type_savings = 80
    elif project_type == "docker":
        layer_suggestions.append("admin_lib.docker")
        type_savings = 60

    total_savings = core_savings + type_savings
    estimated_result = max(line_count - total_savings, 40)

    info("  Migration opportunity:")
    print(f"    admin_lib.core   — replaces ~{core_savings} lines (TUI, colors, run_cmd, signal handling)")
    if project_type == "apple":
        print(f"    admin_lib.apple  — replaces ~{type_savings} lines (xcodebuild, reload, DerivedData)")
    elif project_type == "docker":
        print(f"    admin_lib.docker — replaces ~{type_savings} lines (docker_build, run_with_reload)")
    print(f"    Estimated result: ~{estimated_result} lines (vs {line_count} current)")
    print()

    # Pattern detection
    patterns = [
        (r'subprocess\.Popen.*stdout.*PIPE', "manual Popen + stdout loop", "use run_cmd()"),
        (r'signal\.signal\(signal\.SIGUSR1', "SIGUSR1 handler", "use setup_reload() or run_with_reload()"),
        (r'xcodebuild\b', "xcodebuild invocation", "use xcodebuild_filtered()"),
        (r'docker\s+build', "docker build", "use docker_build()"),
        (r'docker\s+save', "docker save/deploy", "use docker_deploy()"),
        (r'os\.remove.*pid|pid.*os\.remove', "manual PID file cleanup", "use setup_reload() / cleanup_pid_file()"),
        (r'DerivedData', "DerivedData management", "use clean_derived_data()"),
        (r'class\s+C\b.*ANSI|\\033\[3[0-9]m', "inline ANSI color codes", "use admin_lib.core.C"),
        (r'def\s+_tui_menu|def\s+read_key|tty\.setraw', "inline TUI menu", "use admin_lib.core.boot()"),
        (r'OrderedDict.*_commands|_commands\s*=\s*OrderedDict', "manual command registry", "use @command / @core decorators"),
    ]

    found_patterns = []
    for pattern, label, suggestion in patterns:
        for i, line in enumerate(lines, 1):
            if re.search(pattern, line):
                found_patterns.append((i, label, suggestion))
                break

    if found_patterns:
        info("  Extractable patterns:")
        for line_num, label, suggestion in found_patterns:
            print(f"    Line {line_num}: {label} → {suggestion}")
    else:
        ok("  No extractable patterns detected.")

    print()
    return 0


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="init-admin",
        description="Bootstrap new admin scripts from templates, or audit existing ones.",
    )
    parser.add_argument("directory", nargs="?", default=".",
                        help="Project directory (default: current directory)")
    parser.add_argument("--audit", action="store_true",
                        help="Audit an existing admin script")
    parser.add_argument("--type", choices=["apple", "docker", "basic"],
                        dest="project_type",
                        help="Override auto-detected project type (single-target)")
    parser.add_argument("--multi", action="store_true",
                        help="Force multi-target generation")
    parser.add_argument("--force", action="store_true",
                        help="Overwrite existing admin file")

    args = parser.parse_args()
    project_dir = os.path.abspath(args.directory)

    if not os.path.isdir(project_dir):
        err(f"Not a directory: {project_dir}")
        return 1

    if args.audit:
        return audit(project_dir)

    if args.project_type and not args.multi:
        return generate(project_dir, args.project_type, force=args.force)

    targets = detect_all_targets(project_dir)

    if len(targets) == 1 and not args.multi:
        project_type = args.project_type or targets[0]["type"]
        return generate(project_dir, project_type, force=args.force)

    targets = confirm_targets(targets)
    if not targets:
        info("Cancelled.")
        return 0

    return generate_multi(project_dir, targets, force=args.force)


if __name__ == "__main__":
    sys.exit(main() or 0)
